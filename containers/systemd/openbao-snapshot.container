[Unit]
Description=OpenBao Raft snapshot and KV export to R2
After=network-online.target openbao.service
Wants=network-online.target

[Container]
AutoUpdate=registry
ContainerName=openbao-snapshot
Image=ghcr.io/jfroy/openbao-snapshot-etincelle:latest
# The AppRole is bound to 127.0.0.1/32.
Network=host
Volume=/etc/openbao/backup-age.pub:/etc/openbao/backup-age.pub:ro,z
Volume=/var/node-exporter/textfile:/var/node-exporter/textfile:rw,z,U
# Scratch space for plaintext snapshots
Tmpfs=/tmp:mode=1777
# rclone `r2:` remote; credentials, endpoint and bucket come from the env files.
Environment=RCLONE_CONFIG=/dev/null
Environment=RCLONE_CONFIG_R2_TYPE=s3
Environment=RCLONE_CONFIG_R2_PROVIDER=Cloudflare
Environment=RCLONE_CONFIG_R2_REGION=auto
Environment=RCLONE_CONFIG_R2_ACL=private
Environment=RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
# Object name prefix in the bucket
Environment=OPENBAO_BACKUP_HOST=etincelle
EnvironmentFile=/etc/etincelle/secrets/openbao-backup.env
EnvironmentFile=/etc/etincelle/secrets/openbao-snapshot.env

[Service]
# One-shot job started by openbao-snapshot.timer (no RemainAfterExit).
Type=oneshot
