[Unit]
Description=Trove container inventory agent
After=network-online.target podman.socket
Wants=network-online.target
Requires=podman.socket

[Container]
AutoUpdate=registry
ContainerName=trove-agent
Image=ghcr.io/techdox/trove-agent-docker:latest
# Allow access to the Podman socket under SELinux.
SecurityLabelType=container_runtime_t
Volume=/run/podman/podman.sock:/run/podman/podman.sock:ro
Environment=DOCKER_HOST=unix:///run/podman/podman.sock
Environment=TROVE_SERVER_URL=https://trove.kantai.xyz
EnvironmentFile=/etc/etincelle/secrets/trove-agent.env

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
