[Unit]
Description=Talos discovery service
After=network-online.target
Wants=network-online.target

[Container]
AutoUpdate=registry
ContainerName=discovery-service
Image=ghcr.io/siderolabs/discovery-service:v1.1.0@sha256:c33a596985ddb23548275cf350788c95e97dd92209c48eeaa1c9a3c788bd04d8
Network=host
Volume=/var/discovery-service:/var/discovery-service:rw,Z
Exec=-addr :4000 -landing-addr :4001 -metrics-addr :4002

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
